# Postgres connection string (required). Get one free via `npx create-db`
# or a Vercel/Neon/Supabase Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API key for AI 코칭 (optional — can also be set from the app's
# 설정 dialog, which stores it in the AppSetting table instead).
ANTHROPIC_API_KEY=""

# Optional override for the coaching model.
# ANTHROPIC_COACHING_MODEL="claude-sonnet-5"

# Password for the whole app. Leave unset to disable (e.g. local dev).
BASIC_AUTH_PASSWORD=""

# MongoDB connection string for 시장분석 리포트 (optional — must match the
# MONGODB_URI used by the pipeline/ Raspberry Pi job). If unset, /reports and
# the homepage fall back to lib/mock-reports.ts sample data.
MONGODB_URI=""
MONGODB_DB="stock_analyzer"
