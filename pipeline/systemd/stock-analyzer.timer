[Unit]
Description=Run Stock Analyzer pipeline weekdays at 07:00 / 12:00 / 19:00 KST

[Timer]
# systemd >= 239 는 캘린더 표현식 끝에 타임존을 붙일 수 있음. 구버전이면
# `sudo timedatectl set-timezone Asia/Seoul` 로 시스템 시간대를 맞춘 뒤
# "Asia/Seoul" 부분을 지우고 사용하세요.
OnCalendar=Mon..Fri 07,12,19:00 Asia/Seoul
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
